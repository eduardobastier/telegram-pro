index 640e841..9e32ec3 100644
--- a/TMessagesProj_App/google-services.json
+++ b/TMessagesProj_App/google-services.json
@@ -92,6 +92,30 @@
           ]
         }
       }
+    },
+    {
+      "client_info": {
+        "mobilesdk_app_id": "1:760348033671:android:f6afd7b67eae3860",
+        "android_client_info": {
+          "package_name": "com.eduardobastier.telegrampro"
+        }
+      },
+      "oauth_client": [],
+      "api_key": [
+        {
+          "current_key": "AIzaSyA-t0jLPjUt2FxrA8VPK2EiYHcYcboIR6k"
+        }
+      ],
+      "services": {
+        "appinvite_service": {
+          "other_platform_oauth_client": [
+            {
+              "client_id": "760348033671-2hh8ebmuflsnjoc0kldkfells9rhtfni.apps.googleusercontent.com",
+              "client_type": 3
+            }
+          ]
+        }
+      }
     }
   ],
   "configuration_version": "1"
diff --git a/gradle.properties b/gradle.properties
index 55d530f..95c8948 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -15,7 +15,7 @@
